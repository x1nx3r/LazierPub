# Listen
PORT=8787
BOOKS_DIR=/data/novels
# Writable cache for extracted cover images. Keep it off the read-only books mount.
COVERS_DIR=/data/covers

# Client authentication.
# WARNING: empty disables the bearer check. Use only for local development.
LAZIER_TOKEN=

# Prowlarr, reached over the tailnet.
# The magnet URI comes from the search result's guid field.
PROWLARR_URL=http://100.88.88.88:9696
PROWLARR_API_KEY=
# One Newznab category. A comma-separated list is rejected by Prowlarr.
PROWLARR_BOOK_CATEGORIES=7000

# qBittorrent, reached over the tailnet.
# The category decides the download folder, which is the library folder.
QBITTORRENT_URL=http://100.88.88.88:8081
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
QBITTORRENT_CATEGORY=novels
